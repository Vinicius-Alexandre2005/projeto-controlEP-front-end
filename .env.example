# URL base da API de autenticação
VITE_API_BASE_URL=http://localhost:8080/api

# Client ID do Google OAuth (console.cloud.google.com > Credentials > OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Enquanto o backend não estiver pronto, deixe "true": login/cadastro
# funcionam com dados simulados, permitindo navegar pelo site inteiro.
# Troque para "false" assim que a API real estiver no ar.
VITE_USE_MOCK_AUTH=true
